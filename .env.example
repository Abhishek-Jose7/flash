# Set this to your custom domain (e.g., live.yourdomain.com) for automatic SSL
DOMAIN_NAME=live.yourdomain.com

# Use a unique random value of at least 32 characters in production.
ADMIN_KEY=

# Optional: canonical public URL encoded in the QR code (defaults to the request Host)
PUBLIC_URL=

# Optional showcase mode: demo players ramp from 30 to this many (+10 every 20s). 0 = off.
DEMO_PLAYERS=0
